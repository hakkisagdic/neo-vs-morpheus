# dependencies and build output
node_modules/
dist/
coverage/

# pinned upstream checkouts (scripts/deps.sh sync) and their offline bundles
/vendor/
/backups/

# EA's Ultima Online client files (copyrighted, never committed)
/server/client-files/*
!/server/client-files/README.md

# local secrets and runtime output
.env
*.log
/runs/

# the fleet's machines (fleet.example.json shows the shape) and what it fetched from them
/fleet.json
/.fleet/

.DS_Store

# native Laya env, HF cache and fine-tuning output (scripts/laya-native.sh, training/)
/.laya/

# distillation data (teacher outputs) and checkpoints stay local
/training/data/
/training/checkpoints/

# python bytecode
__pycache__/
