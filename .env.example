# Copy to .env and fill in. .env is git-ignored.

# --- ModernUO arena -------------------------------------------------------------------
# Owner (GM) account, created on the first boot. The bot's orchestrator logs in with it.
NEO_OWNER_USER=architect
NEO_OWNER_PASS=

# Address the server hands to clients for the game connection. 127.0.0.1 for bots on this
# machine; this machine's LAN IP (plus UO_BIND_ADDRESS=0.0.0.0) for clients elsewhere.
NEO_PUBLIC_ADDRESS=127.0.0.1
UO_BIND_ADDRESS=127.0.0.1

# Folder with real Ultima Online client files. Empty = synthetic flat arena.
# UO_DATA_DIR=./server/client-files

# 7 = Mondain's Legacy (see vendor/modernuo/Distribution/Data/expansions.json for the list)
NEO_EXPANSION=7
# Duel spot: Felucca, Jhelom Islands (no guards).
NEO_ARENA_MAP=Felucca
NEO_ARENA_X=1180
NEO_ARENA_Y=3610

# --- Decision models (both speak the Jev System One API: POST /v1/systemone) -----------
# Local Laya. Docker (docker compose, CPU only on macOS): http://127.0.0.1:8000
# Native on Apple silicon (scripts/laya-native.sh start, Metal, ~10x faster): http://127.0.0.1:8001
LAYA_URL=http://127.0.0.1:8000
LAYA_API_KEY=
LAYA_THREADS=4

# Jev (cloud). Leave the key empty to disable Jev.
# TypeSafe:  JEV_URL=https://api.typesafe.ai   JEV_PATH=/v1/systemone
# FreeJev (third-party proxy, 10k signup credits, 30 req/min, one at a time):
#            JEV_URL=https://freejev.org       JEV_PATH=/api/v1/decisions
JEV_URL=https://api.typesafe.ai
JEV_PATH=/v1/systemone
JEV_MODEL=
JEV_API_KEY=

# --- Bot ------------------------------------------------------------------------------
UO_HOST=127.0.0.1
UO_PORT=2593
MONITOR_PORT=8765

# Password for the bot accounts (neo, morpheus, ...); they are created on first login.
BOT_PASSWORD=
